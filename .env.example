# Copy to .env and fill in. Never commit the real .env.

# groq | gemini | openai | anthropic | openrouter
LLM_PROVIDER=groq
LLM_API_KEY=
# Leave empty for the provider default (groq -> openai/gpt-oss-120b)
LLM_MODEL=
# Used when the main model is rate-limited (groq default: qwen/qwen3.8-27b; "none" disables)
LLM_FALLBACK_MODEL=
# Seconds per LLM call. Kept well under the judge's 15s budget.
LLM_TIMEOUT=9

# Port for local runs / hosting platforms that inject PORT
PORT=8080
